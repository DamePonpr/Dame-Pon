{
  "name": "@workspace/dame-pon-pasajero",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "node scripts/validate-supabase-config.mjs && sh -c 'if [ -n \"$REPLIT_EXPO_SESSION_SECRET\" ]; then pnpm exec create-launch login --session \"$REPLIT_EXPO_SESSION_SECRET\" || true; fi' && EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT",
    "build": "pnpm run test:supabase-config && node scripts/build.js",
    "build:publish": "pnpm run verify:supabase-rls && pnpm run build",
    "serve": "node server/serve.js",
    "typecheck": "pnpm run test:supabase-config && tsc -p tsconfig.json --noEmit",
    "test:supabase-config": "node --test scripts/validate-supabase-config.test.mjs",
    "test:role-routing": "node --test scripts/role-routing.test.mjs",
    "test:rating-flow": "node --test scripts/rating-flow.test.mjs",
    "test:map-config": "node --test scripts/map-config.test.mjs",
    "test:brand-mark": "node --test scripts/brand-mark.test.mjs",
    "verify:supabase-config": "node scripts/validate-supabase-config.mjs",
    "verify:supabase-rls": "pnpm run verify:supabase-config && node scripts/verify-supabase-rls.mjs",
    "verify:trip-realtime": "pnpm run verify:supabase-config && node scripts/verify-trip-realtime.mjs",
    "verify:rls-hardening": "pnpm run verify:supabase-config && node scripts/verify-rls-hardening.mjs",
    "verify:trip-request": "pnpm run verify:supabase-config && node scripts/verify-trip-request.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@expo/config-plugins": "57.0.9",
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "catalog:",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "@ungap/structured-clone": "^1.3.0",
    "@workspace/api-client-react": "workspace:*",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "babel-preset-expo": "57.0.10",
    "create-launch": "0.3.6",
    "expo": "~57.0.7",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.5",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-location": "~57.0.5",
    "expo-router": "~57.0.7",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "3.3.2",
    "typescript": "~6.0.3",
    "zod": "catalog:",
    "zod-validation-error": "^3.4.0"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@maplibre/maplibre-react-native": "11.3.10",
    "@supabase/supabase-js": "^2.115.0",
    "@twotalltotems/react-native-otp-input": "^1.3.11",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-local-authentication": "^57.0.3",
    "expo-notifications": "~57.0.17",
    "expo-secure-store": "^57.0.4",
    "nativewind": "^4.2.7",
    "react-native-css-interop": "^0.2.7",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-modal": "14.0.0-rc.1",
    "react-native-swiper": "^1.6.0",
    "zustand": "^5.0.15",
    "@workspace/dame-pon-shared": "workspace:*"
  }
}
