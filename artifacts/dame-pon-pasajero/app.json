{
  "expo": {
    "name": "Dame Pon",
    "slug": "dame-pon-pasajero",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dame-pon-pasajero",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "package": "com.damepon.damepon",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#081321"
      }
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#081321"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withPreviewSigning",
      "./plugins/withPreviewBuildVersion",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Dame Pon usa tu ubicación para coordinar el punto de recogida y mostrar el conductor en el mapa durante el viaje."
        }
      ],
      [
        "@maplibre/maplibre-react-native",
        {
          "android": {
            "nativeVariant": "opengl",
            "locationEngine": "default"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B1C26"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "damePonRole": "pasajero",
      "eas": {
        "projectId": "b7241380-ec5b-467f-9e2a-761119ab2d50"
      }
    }
  }
}
